# --- Server (server/.env) ---
# String de conexion a Postgres (Supabase). Se obtiene en:
# Supabase Dashboard > Project Settings > Database > Connection string (URI, modo "Session pooler")
# NOTA: la conexion directa (db.<ref>.supabase.co:5432) requiere IPv6 y puede no funcionar en redes sin
# soporte IPv6. Usar el connection pooler (host aws-0-<region>.pooler.supabase.com) que es compatible con IPv4.
DATABASE_URL="postgresql://postgres.qqxfwrusjeicmsihrrmf:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio"
PORT=4000
CLIENT_URL="http://localhost:5173"
NODE_ENV=development

# --- Client (client/.env) ---
VITE_API_URL="http://localhost:4000/api"
VITE_SUPABASE_URL="https://qqxfwrusjeicmsihrrmf.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_sthz0tt943Udmh2siRLKnA_rtxbEbhw"
